<?xml version="1.0" encoding="utf-8"?>
<!-- ΝΕΟ (ζητήθηκε ρητά, 6/11, v4 — "ακριβώς όπως το 4χ2"): ΔΕΝ χρησιμοποιεί πια το
     widget_steps_compact.xml (ίδιο με το 2x1) — τώρα δικό του, μεγαλύτερο layout
     "@layout/widget_steps_medium", με την ΙΔΙΑ δομή 3 κάθετων σειρών με το 2x1/4x2 (βλ. εκτενές σχόλιο
     στο ίδιο το layout), απλά μεγαλύτερο. minHeight 70dp -> 98dp, αφού τώρα έχει ΤΡΕΙΣ σειρές
     (brand+παλέτα / δακτύλιος+κάρτες / Open App), όχι πια μία ενιαία οριζόντια σειρά. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="230dp"
    android:minHeight="98dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_steps_medium"
    android:previewLayout="@layout/widget_steps_medium"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_steps_description">
</appwidget-provider>
