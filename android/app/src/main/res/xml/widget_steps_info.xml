<?xml version="1.0" encoding="utf-8"?>
<!-- ΝΕΟ (5/11, redesign ζητήθηκε ρητά): μεταδεδομένα του home-screen widget βημάτων.
     ΔΙΟΡΘΩΣΗ (bug report, "πολύ περιθώριο πάνω/κάτω"): targetCellHeight 2 -> 1 και minHeight 110dp -> 96dp,
     ώστε οι launchers να ζητούν ένα λιγότερο ψηλό κελί εξαρχής αντί να αφήνουν μεγάλο κενό γύρω από το
     περιεχόμενο. Η πραγματική ύψος-ανά-κελί τιμή διαφέρει ανά συσκευή/launcher (π.χ. Samsung One UI συχνά
     δίνει πιο ψηλά κελιά από το "επίσημο" τυπικό), οπότε αυτό βελτιώνει αλλά δεν εγγυάται πλήρως το ίδιο σε
     όλες τις συσκευές, resizeMode παραμένει ανοιχτό ώστε ο χρήστης να μπορεί ΑΚΟΜΑ να το προσαρμόσει
     χειροκίνητα αν χρειαστεί. updatePeriodMillis=1800000 (30 λεπτά) -> ελάχιστο αξιόπιστο διάστημα που επιτρέπει το ίδιο το
     Android (τιμές κάτω από ~30' αγνοούνται από το OS), λειτουργεί ως εφεδρική/περιοδική ανανέωση· η
     ΖΩΝΤΑΝΗ ανανέωση γίνεται απευθείας είτε από το JS (FytraStepEngine.updateWidgetNative) όσο η εφαρμογή
     είναι ανοιχτή, είτε απευθείας από το native side (FytraStepCounterPlugin.creditOneStep) ΑΚΟΜΑ κι όταν
     η εφαρμογή είναι εντελώς κλειστή, όσο τρέχει το Foreground Service. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="96dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_steps"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_steps_description">
</appwidget-provider>
