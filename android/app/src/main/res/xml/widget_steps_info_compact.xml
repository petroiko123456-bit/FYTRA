<?xml version="1.0" encoding="utf-8"?>
<!-- ΝΕΟ (ζητήθηκε ρητά, 6/11): μεταδεδομένα της μικρής (2x1) έκδοσης του widget βημάτων. Εμφανίζεται
     στον επιλογέα μεγέθους widget ΩΣ ΞΕΧΩΡΙΣΤΗ επιλογή από το κανονικό 4x2 (κάθε μέγεθος που θες να
     εμφανίζεται ως δική του επιλογή στον επιλογέα του Android χρειάζεται δικό του receiver/provider-info,
     δεν αρκεί μόνο minWidth/minHeight πάνω στο ίδιο provider). targetCellWidth=2, targetCellHeight=1: οι
     τιμές minWidth/minHeight ακολουθούν τον ίδιο τύπο (70dp*n-30dp) που χρησιμοποιήθηκε και για το
     κανονικό μέγεθος. resizeMode ανοιχτό ώστε ο χρήστης να μπορεί ακόμα να το μεγαλώσει αν θέλει.
     ΔΙΟΡΘΩΣΗ (ζητήθηκε ρητά, v3): minHeight 40dp ανέβηκε σε 58dp, αφού προστέθηκε ορατό κουμπί
     "Open App" κάτω στο layout (widget_steps_compact.xml) και χρειάζεται λίγο παραπάνω ύψος για να
     χωρέσει χωρίς να κοπεί, το targetCellHeight παραμένει 1, αφού το πραγματικό ύψος ενός "1 σειράς"
     κελιού στους περισσότερους launcher είναι ήδη μεγαλύτερο από το 40dp που έδινε η φόρμουλα. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="58dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_steps_compact"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_steps_description">
</appwidget-provider>
