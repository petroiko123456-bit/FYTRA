<?xml version="1.0" encoding="utf-8"?>
<!-- ΝΕΟ (ζητήθηκε ρητά, 6/11): μεταδεδομένα της μικρής (2x1) έκδοσης του widget βημάτων. Εμφανίζεται
     στον επιλογέα μεγέθους widget ΩΣ ΞΕΧΩΡΙΣΤΗ επιλογή από το κανονικό 4x2 (κάθε μέγεθος που θες να
     εμφανίζεται ως δική του επιλογή στον επιλογέα του Android χρειάζεται δικό του receiver/provider-info,
     δεν αρκεί μόνο minWidth/minHeight πάνω στο ίδιο provider). targetCellWidth=2, targetCellHeight=1,
     resizeMode ανοιχτό ώστε ο χρήστης να μπορεί ακόμα να το μεγαλώσει αν θέλει.
     ΔΙΟΡΘΩΣΗ (ζητήθηκε ρητά, 6/11, v8 — "ακριβώς όπως το 4χ2"): το layout απέκτησε ΤΡΕΙΣ κάθετες
     σειρές (brand+παλέτα / δακτύλιος+κάρτες / Open App), ίδια δομή με το 4x2 — minWidth 110dp->136dp,
     minHeight 76dp->94dp, ώστε να χωρούν όλες οι σειρές χωρίς να κοπούν. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="136dp"
    android:minHeight="94dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_steps_compact"
    android:previewLayout="@layout/widget_steps_compact"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_steps_description">
</appwidget-provider>
