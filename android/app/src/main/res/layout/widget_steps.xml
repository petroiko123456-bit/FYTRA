<?xml version="1.0" encoding="utf-8"?>
<!-- ΝΕΟ (5/11, redesign ζητήθηκε ρητά): "επαγγελματικό" widget βημάτων — δακτύλιος προόδου (ΖΩΓΡΑΦΙΖΕΤΑΙ
     προγραμματιστικά ως bitmap στο FytraStepsWidgetProvider.drawProgressRingBitmap(), αφού RemoteViews ΔΕΝ
     υποστηρίζει dynamic SVG/vector progress ring), κάρτες kcal/km, κουμπί αλλαγής θέματος (έξι θέματα
     χρώματος, βλ. KEY_WIDGET_THEME_INDEX) και κάρτα "Στόχος!" που εμφανίζεται μόνο όταν πιάνεται ο
     προσωπικός στόχος. Όλα τα χρώματα/φόντα εδώ είναι απλά "placeholders" στο default (χρυσό, index 0) —
     αντικαθίστανται δυναμικά ΚΑΘΕ update από το buildRemoteViews() ανάλογα με το επιλεγμένο θέμα. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <!-- ================= TOP ROW: brand + theme button + (προαιρετική) κάρτα στόχου ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/widgetBrandBadge"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/badge_bg_0">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_paw"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/widgetBrandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="FYTRA"
                    android:textColor="#F0E2BC"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widgetThemeBtn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/icon_wrap_bg_0">
                <ImageView
                    android:id="@+id/widgetThemeBtnIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_palette"/>
            </FrameLayout>

            <!-- Κάρτα "Στόχος!" — width=0dp + weight=1 ώστε, όταν GONE, η πάνω σειρά να μένει απλά
                 "brand + κουμπί θέματος" ευθυγραμμισμένα αριστερά (ακριβώς όπως στο εγκεκριμένο mockup). -->
            <LinearLayout
                android:id="@+id/widgetGoalCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/goal_card_bg"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🎉"
                        android:textSize="15sp"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Στόχος!"
                            android:textColor="#241A0C"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_widget_trophy"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Συγχαρητήρια"
                        android:textColor="#5C4213"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= MAIN ROW: δακτύλιος + κάρτες kcal/km =================
             ΔΙΟΡΘΩΣΗ (bug report 5/11, "ισοπεδώθηκε/δεν μετράει σε Samsung"): layout_height="0dp" +
             layout_weight="1" για ΥΨΟΣ μέσα σε RemoteViews (home-screen widget) είναι γνωστό ότι
             αποδίδεται ασταθές σε αρκετούς OEM launchers (π.χ. One UI), σε αντίθεση με weight σε
             ΠΛΑΤΟΣ (π.χ. η κάρτα "Στόχος!" παρακάτω), που είναι πολύ πιο αξιόπιστο. Αλλάζει σε
             wrap_content -> το ύψος της σειράς καθορίζεται πλέον από το ΙΔΙΟ το περιεχόμενο (ο
             δακτύλιος έχει σταθερό μέγεθος 86dp), όχι από flexible fill, άρα δεν μπορεί να "καταρρεύσει". -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp">

                <!-- Γεμίζει δυναμικά με setImageViewBitmap(), βλ. drawProgressRingBitmap() -->
                <ImageView
                    android:id="@+id/widgetRingImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widgetRingNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFE07A"
                        android:textSize="19sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="βήματα"
                        android:textColor="#B89A5A"
                        android:textSize="9sp"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widgetKcalWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/stat_bg_0">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/icon_wrap_bg_0">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_widget_flame"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widgetKcalVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 kcal"
                            android:textColor="#FFF3DC"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Θερμίδες"
                            android:textColor="#B89A5A"
                            android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widgetKmWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/stat_bg_0">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/icon_wrap_bg_0">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_widget_pin"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widgetKmVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,00 km"
                            android:textColor="#FFF3DC"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Απόσταση"
                            android:textColor="#B89A5A"
                            android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
