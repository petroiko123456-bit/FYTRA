<?xml version="1.0" encoding="utf-8"?>
<!-- ΝΕΟ (5/11, redesign ζητήθηκε ρητά): "επαγγελματικό" widget βημάτων — δακτύλιος προόδου (ΖΩΓΡΑΦΙΖΕΤΑΙ
     προγραμματιστικά ως bitmap στο FytraStepsWidgetProvider.drawProgressRingBitmap(), αφού RemoteViews ΔΕΝ
     υποστηρίζει dynamic SVG/vector progress ring), κάρτες kcal/km, κουμπί αλλαγής θέματος (έξι θέματα
     χρώματος, βλ. KEY_WIDGET_THEME_INDEX) και κάρτα "Στόχος!" που εμφανίζεται μόνο όταν πιάνεται ο
     προσωπικός στόχος. Όλα τα χρώματα/φόντα εδώ είναι απλά "placeholders" στο default (χρυσό, index 0) —
     αντικαθίστανται δυναμικά ΚΑΘΕ update από το buildRemoteViews() ανάλογα με το επιλεγμένο θέμα. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- ================= TOP ROW: brand + theme button + (προαιρετική) κάρτα στόχου ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/widgetBrandBadge"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/badge_bg_0">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_paw"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/widgetBrandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="FYTRA"
                    android:textColor="#F0E2BC"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widgetThemeBtn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/icon_wrap_bg_0">
                <ImageView
                    android:id="@+id/widgetThemeBtnIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_palette"/>
            </FrameLayout>

            <!-- Κάρτα "Στόχος!" — width=0dp + weight=1 ώστε, όταν GONE, η πάνω σειρά να μένει απλά
                 "brand + κουμπί θέματος" ευθυγραμμισμένα αριστερά (ακριβώς όπως στο εγκεκριμένο mockup). -->
            <LinearLayout
                android:id="@+id/widgetGoalCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/goal_card_bg"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🎉"
                        android:textSize="15sp"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Στόχος!"
                            android:textColor="#241A0C"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_widget_trophy"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Συγχαρητήρια"
                        android:textColor="#5C4213"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ================= MAIN ROW: δακτύλιος + κάρτες kcal/km =================
             ΔΙΟΡΘΩΣΗ (bug report 5/11, "ισοπεδώθηκε/δεν μετράει σε Samsung"): layout_height="0dp" +
             layout_weight="1" για ΥΨΟΣ μέσα σε RemoteViews (home-screen widget) είναι γνωστό ότι
             αποδίδεται ασταθές σε αρκετούς OEM launchers (π.χ. One UI), σε αντίθεση με weight σε
             ΠΛΑΤΟΣ (π.χ. η κάρτα "Στόχος!" παρακάτω), που είναι πολύ πιο αξιόπιστο. Αλλάζει σε
             wrap_content -> το ύψος της σειράς καθορίζεται πλέον από το ΙΔΙΟ το περιεχόμενο (ο
             δακτύλιος έχει σταθερό μέγεθος 86dp), όχι από flexible fill, άρα δεν μπορεί να "καταρρεύσει". -->
        <!-- ΔΙΟΡΘΩΣΗ (bug report, "πολύ περιθώριο πάνω/κάτω"): το εξωτερικό padding πάνω/κάτω μικρύνθηκε
             (14/16dp -> 8/8dp) και ο δακτύλιος μεγάλωσε ελάχιστα (86dp -> 94dp, βλ. και drawProgressRingBitmap)
             ώστε το περιεχόμενο να γεμίζει καλύτερα το ύψος του widget. Μέρος του εναπομείναντος κενού
             μπορεί να οφείλεται στο πόσο ψηλό κελί δίνει ο launcher (π.χ. One UI) στο minHeight/targetCellHeight
             του widget_steps_info.xml, εκτός ελέγχου μας από εδώ, γι' αυτό μικρύναμε και εκείνα. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="94dp"
                android:layout_height="94dp">

                <!-- Γεμίζει δυναμικά με setImageViewBitmap(), βλ. drawProgressRingBitmap() -->
                <ImageView
                    android:id="@+id/widgetRingImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widgetRingNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFE07A"
                        android:textSize="19sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="βήματα"
                        android:textColor="#B89A5A"
                        android:textSize="9sp"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widgetKcalWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/stat_bg_0">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/icon_wrap_bg_0">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_widget_flame"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widgetKcalVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 kcal"
                            android:textColor="#FFF3DC"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Θερμίδες"
                            android:textColor="#B89A5A"
                            android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widgetKmWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/stat_bg_0">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/icon_wrap_bg_0">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_widget_pin"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widgetKmVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,00 km"
                            android:textColor="#FFF3DC"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Απόσταση"
                            android:textColor="#B89A5A"
                            android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ΝΕΟ (ζητήθηκε ρητά, 5/11): πλέον το πάτημα στο ΚΥΡΙΟ σώμα του widget (widgetRoot) κάνει
             REFRESH (βλ. ACTION_WIDGET_REFRESH), ΔΕΝ ανοίγει πια την εφαρμογή. Το άνοιγμα της
             εφαρμογής μεταφέρθηκε σε αυτό το ξεχωριστό κουμπί "Open App" κάτω δεξιά, με δικό του
             explicit click target (όπως και το κουμπί θέματος/η κουκκίδα info) ώστε να ΜΗΝ "διαρρέει"
             το touch στο γονικό widgetRoot.
             ΔΙΟΡΘΩΣΗ (bug report, "βγαίνει εκτός ορίων"): εκτός από το minHeight/targetCellHeight που
             μεγαλώσαμε στο widget_steps_info.xml, μικρύναμε ΚΑΙ το ίδιο το κουμπί (λιγότερο κάθετο
             padding, μικρότερο κείμενο, μικρότερο πάνω περιθώριο) ώστε να χρειάζεται λιγότερο συνολικό
             ύψος, έτσι χωράει πιο αξιόπιστα και σε launcher που δεν τηρεί ακριβώς το ζητούμενο ύψος. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="end"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widgetOpenAppBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/stat_bg_0">
                <TextView
                    android:id="@+id/widgetOpenAppText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open App"
                    android:textColor="#FFF3DC"
                    android:textSize="9sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ΔΙΟΡΘΩΣΗ (bug report): η κουκκίδα "i" μετακόμισε ΕΞΩ από την πάνω σειρά (που μοιράζεται χώρο με
         την κάρτα "Στόχος!") και μπήκε ΕΔΩ, ως δικό της, ανεξάρτητο child ΑΠΕΥΘΕΙΑΣ μέσα στο widgetRoot
         (FrameLayout) με layout_gravity="top|end", έτσι κάθεται ΠΑΝΤΑ στην απόλυτη κορυφή-δεξιά γωνία
         του widget, ΑΝΕΞΑΡΤΗΤΑ από το αν/πότε εμφανιστεί η κάρτα "Στόχος!" στην πάνω σειρά. Δεν μπορεί
         ποτέ να "πέσει πάνω της" ούτε να σπρωχτεί, αφού δεν μοιράζεται καθόλου row/weight με αυτή. -->
    <FrameLayout
        android:id="@+id/widgetInfoBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/icon_wrap_bg_0">
        <TextView
            android:id="@+id/widgetInfoBtnText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="i"
            android:textStyle="bold|italic"
            android:textSize="13sp"
            android:textColor="#F0E2BC"/>
    </FrameLayout>

    <!-- ΝΕΟ (ζητήθηκε ρητά): ΑΝΤΙ για Toast (που εμφανιζόταν κομμένο κάτω στην οθόνη, εκτός ελέγχου μας:
         θέση/μέγεθος Toast από background receiver δεν ρυθμίζεται πλέον σε πρόσφατο Android), το "i"
         τώρα ανοιγοκλείνει ΑΥΤΟ το popup, ΜΕΣΑ στο ίδιο το widget, δίπλα-κάτω από το κουμπί "i", με δικό
         του κουμπί "✕" για κλείσιμο. Ελέγχεται απόλυτα από εμάς (visibility GONE/VISIBLE μέσω
         buildRemoteViews(), βλ. KEY_WIDGET_INFO_VISIBLE), πάντα εντός των ορίων του widget. -->
    <LinearLayout
        android:id="@+id/widgetInfoBubble"
        android:layout_width="192dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:background="@drawable/popup_bg_0"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Πώς δουλεύει"
                android:textColor="#FFF3DC"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <FrameLayout
                android:id="@+id/widgetInfoCloseBtn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/icon_wrap_bg_0">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✕"
                    android:textColor="#F0E2BC"
                    android:textSize="10sp"/>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widgetInfoBubbleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Πατώντας επάνω στο widget μπορείς να συγχρονίσεις τα βήματα που κάνεις όσο η εφαρμογή είναι κλειστή, με την προϋπόθεση όμως ότι συνεχίζεις να περπατάς. Αν η εφαρμογή όμως είναι ενεργή στο παρασκήνιο, τότε τα βήματά σου ενημερώνονται μόνα τους σε πραγματικό χρόνο."
            android:textColor="#D8C9A0"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
</FrameLayout>
