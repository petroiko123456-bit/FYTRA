<?xml version="1.0" encoding="utf-8"?>
<!-- ΝΕΟ (ζητήθηκε ρητά, 6/11, v5): μικρή έκδοση (2x1, και 3x1 που delegate-άρει εδώ) του widget
     βημάτων. ΔΙΟΡΘΩΣΗ (ζητήθηκε ρητά): επιστροφή στην ΑΠΟΛΥΤΗ θέση "i" πάνω-δεξιά στη γωνία (ΟΧΙ πια
     μέσα στη σειρά περιεχομένου, βλ. προηγούμενη εκδοχή v4), ΟΠΩΣ ήταν αρχικά. Για να μην ακουμπάει στο
     kcal/km, έγιναν ΔΥΟ αλλαγές: (1) το "i" μίκρυνε (13dp αντί 17dp), (2) το paddingEnd του περιεχομένου
     ανέβηκε σε 26dp (από 20dp) ώστε να μείνει πραγματικό "κενό ασφαλείας" δεξιά του kcal/km, μεγαλύτερο
     από το πλάτος που πιάνει το μικρότερο πλέον "i" (13dp+3dp περιθώριο=16dp). Έτσι το περιεχόμενο ΔΕΝ
     μπορεί να απλωθεί μέχρι εκεί που βρίσκεται το "i", ανεξάρτητα από το πόσο στενό είναι το widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCompactRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_0">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="26dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">
                <!-- Γεμίζει δυναμικά, ίδια μέθοδος drawProgressRingBitmap() με το κανονικό widget,
                     μικρότερο sizePx (βλ. FytraStepsWidgetProviderCompact.buildRemoteViewsCompact). -->
                <ImageView
                    android:id="@+id/widgetCompactRingImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widgetCompactStepsNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFE07A"
                    android:textSize="12.5sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="βήματα"
                    android:textColor="#B89A5A"
                    android:textSize="7sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widgetCompactKcalVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kcal"
                    android:textColor="#FFF3DC"
                    android:textSize="8sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/widgetCompactKmVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0,00 km"
                    android:textColor="#FFF3DC"
                    android:textSize="8sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="end"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/widgetCompactOpenAppBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/stat_bg_0">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open App"
                    android:textColor="#FFF3DC"
                    android:textSize="7.5sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ΝΕΟ: κουκκίδα "i", ΠΙΣΩ στην απόλυτη θέση πάνω-δεξιά στη γωνία, όπως ζητήθηκε. Μικρότερη
         (13dp αντί 17dp) ώστε να χωράει με ασφάλεια μέσα στο κενό που αφήνει το μεγαλύτερο paddingEnd
         του περιεχομένου (βλ. σχόλιο στην κορυφή του αρχείου). -->
    <FrameLayout
        android:id="@+id/widgetCompactInfoBtn"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/icon_wrap_bg_0">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="i"
            android:textStyle="bold|italic"
            android:textSize="7sp"
            android:textColor="#F0E2BC"/>
    </FrameLayout>

    <!-- ΝΕΟ: popup του "i", ευθυγραμμισμένο κάτω από την (μικρότερη) κουκκίδα. -->
    <LinearLayout
        android:id="@+id/widgetCompactInfoBubble"
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        android:background="@drawable/popup_bg_0"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Πώς δουλεύει"
                android:textColor="#FFF3DC"
                android:textSize="9.5sp"
                android:textStyle="bold"/>
            <FrameLayout
                android:id="@+id/widgetCompactInfoCloseBtn"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:background="@drawable/icon_wrap_bg_0">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✕"
                    android:textColor="#F0E2BC"
                    android:textSize="8sp"/>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Πατώντας επάνω στο widget μπορείς να συγχρονίσεις τα βήματα που κάνεις όσο η εφαρμογή είναι κλειστή, με την προϋπόθεση όμως ότι συνεχίζεις να περπατάς. Αν η εφαρμογή όμως είναι ενεργή στο παρασκήνιο, τότε τα βήματά σου ενημερώνονται μόνα τους σε πραγματικό χρόνο."
            android:textColor="#D8C9A0"
            android:textSize="8.5sp"
            android:lineSpacingExtra="1dp"/>

        <TextView
            android:id="@+id/widgetCompactOpenAppLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Άνοιγμα εφαρμογής →"
            android:textColor="#FFE07A"
            android:textSize="9sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
