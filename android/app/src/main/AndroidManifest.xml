<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
<!-- ΝΕΟ (Σενάριο Γ - μοιρασμα βηματων στη σωστη ημερα μεσω μεσονυκτιου "στιγμιοτυπου", βλ.
     FytraMidnightSnapshotReceiver.kt): χρειαζεται για να ξαναπρογραμματισει το alarm μετα απο
     επανεκκινηση της συσκευης (τα alarms του AlarmManager δεν επιζουν reboot). ΔΕΝ χρειαζεται
     SCHEDULE_EXACT_ALARM, αφου χρησιμοποιειται το ανεκτικο setAndAllowWhileIdle. -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
<!-- ΝΕΟ: χρειάζεται από το FytraMidnightSnapshotReceiver.kt για το σύντομο, τοπικό WakeLock
     (acquireShortWakeLock) — κρατάει την CPU ξύπνια μόνο για τα λίγα δευτερόλεπτα που περιμένουμε
     απάντηση από τον αισθητήρα TYPE_STEP_COUNTER. ΔΕΝ σχετίζεται με το God Mode/ζωντανή μέτρηση. -->
<uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
                <service
            android:name="com.fytra.app.FytraStepForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- ΝΕΟ (ζητήθηκε ρητά, 6/11): σύντομο Service που ξεκινάει ΜΟΝΟ από το tap-to-refresh στο
             widget, ώστε να έχει πολύ μεγαλύτερο παράθυρο αναμονής του αισθητήρα από το goAsync() (βλ.
             FytraWidgetCatchUpService.kt). Ίδιο foregroundServiceType="dataSync" με το παραπάνω,
             χρησιμοποιεί τις ίδιες, ήδη δηλωμένες άδειες (FOREGROUND_SERVICE_DATA_SYNC). -->
        <service
            android:name="com.fytra.app.FytraWidgetCatchUpService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- ΝΕΟ (Σενάριο Γ): δεχεται το μεσονυκτιο AlarmManager alarm ΚΑΙ το BOOT_COMPLETED, ακομα
             κι αν η εφαρμογη ειναι ΕΝΤΕΛΩΣ κλειστη. Βλ. FytraMidnightSnapshotReceiver.kt. -->
        <receiver
            android:name="com.fytra.app.FytraMidnightSnapshotReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ΝΕΟ (5/11, ζητήθηκε ρητά): home-screen widget βημάτων. Βλ. FytraStepsWidgetProvider.kt +
             FytraStepCounterPlugin.updateWidgetData(), διαβάζει ΜΟΝΟ το δικό του, ξεχωριστό
             "display cache" SharedPreferences αρχείο, καμία επίδραση στο God Mode/v1/v2 filter.
             ΝΕΟ (redesign, θέματα widget): προστέθηκε και το ACTION_CYCLE_WIDGET_THEME, το custom
             broadcast που στέλνει το ίδιο το κουμπί παλέτας πάνω στο widget (βλ.
             FytraStepsWidgetProvider.ACTION_CYCLE_THEME), ΔΕΝ ανοίγει την εφαρμογή. -->
        <receiver
            android:name="com.fytra.app.FytraStepsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fytra.app.ACTION_CYCLE_WIDGET_THEME" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info" />
        </receiver>

        <!-- ΝΕΟ (ζητήθηκε ρητά, 6/11): "μικρή" εκδοχή (2x1) του widget βημάτων, ξεχωριστή
             receiver/class (FytraStepsWidgetProviderCompact) ώστε να εμφανίζεται ΩΣ ΔΙΚΗ ΤΗΣ επιλογή
             μεγέθους στον επιλογέα widget του Android, δίπλα στο κανονικό 4x2 από πάνω. Μοιράζονται το
             ΙΔΙΟ display-cache SharedPreferences, βλ. σχόλια στο .kt αρχείο. -->
        <receiver
            android:name="com.fytra.app.FytraStepsWidgetProviderCompact"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info_compact" />
        </receiver>

        <!-- ΝΕΟ (ζητήθηκε ρητά, 6/11): τρίτη επιλογή μεγέθους (3 στήλες), ΑΚΡΙΒΩΣ το ίδιο περιεχόμενο με
             το κανονικό 4x2 (ίδιο layout/λογική, βλ. FytraStepsWidgetProviderMedium.kt). -->
        <receiver
            android:name="com.fytra.app.FytraStepsWidgetProviderMedium"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info_medium" />
        </receiver>

        <!-- ΝΕΟ (ζητήθηκε ρητά, 6/11): τέταρτη επιλογή μεγέθους, 3x2, με το ΠΛΗΡΕΣ περιεχόμενο του 4x2
             (βλ. FytraStepsWidgetProviderWide.kt). -->
        <receiver
            android:name="com.fytra.app.FytraStepsWidgetProviderWide"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info_wide" />
        </receiver>

        <!-- ΝΕΟ (31/10, ζητήθηκε ρητά): AdMob App ID -> απαιτείται από το @capacitor-community/admob plugin
             ΑΚΟΜΑ κι όταν δεν έχει τρέξει καμία διαφήμιση ακόμα (αλλιώς crash στο initialize()). Αυτό είναι
             το ΕΠΙΣΗΜΟ δημόσιο TEST App ID της Google (ca-app-pub-3940256099942544~3347511713, τεκμηριωμένο
             σε developers.google.com/admob/android/test-ads) -> δείχνει ΜΟΝΟ δοκιμαστικές διαφημίσεις, καμία
             πραγματική χρέωση/έσοδο, ΔΕΝ χρειάζεται δικό σου AdMob account ακόμα. ΑΝΤΙΚΑΤΑΣΤΗΣΕ το value με
             το δικό σου πραγματικό App ID μόλις δημιουργήσεις λογαριασμό AdMob. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
